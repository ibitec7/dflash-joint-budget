lm_algorithm_config: Annotated[Optional[str], 'The diffusion LLM algorithm configurations. Must be a YAML file.'] = None, dllm_fdfo: Annotated[bool, Arg(help='Enable First-Done-First-Out (FDFO) scheduling for diffusion LLM inference. Enabled by default; use --no-dllm-fdfo to fall back to synchronous block scheduling.', choices=None, aliases=None, cli_name=None, type_parser=None, nargs=None, required=None, action=<class 'argparse.BooleanOptionalAction'>, action_kwargs=None, const=None, no_cli=False, resolvable=False, fallback=None)] = True, disaggregation_mode: Annotated[Literal['null', 'prefill', 'decode'], 'Only used for PD disaggregation. "prefill" for prefill-only server, and "decode" for decode-only server. If not specified, it is not PD disaggregated'] = 'null', disaggregation_transfer_backend: Annotated[str, Arg(help='The backend for disaggregation transfer. Default is mooncake.', choices=['mooncake', 'nixl', 'ascend', 'fake', 'mori', 'mooncake_tcp'], aliases=None, cli_name=None, type_parser=None, nargs=None, required=None, action=None, action_kwargs=None, const=None, no_cli=False, resolvable=False, fallback=None)] = 'mooncake', disaggregation_bootstrap_port: Annotated[int, 'Bootstrap server port on the prefill server. Default is 8998.'] = 8998, disaggregation_ib_device: Annotated[Optional[str], 'The InfiniBand devices for disaggregation transfer. Supports a single device (e.g., --disaggregation-ib-device mlx5_0), a shared comma-separated list (e.g., --disaggregation-ib-device mlx5_0,mlx5_1), a per-GPU JSON mapping (e.g., --disaggregation-ib-device \'{"0": "mlx5_0,mlx5_1", "1": "mlx5_2"}\'), or a path to a JSON file containing that mapping. Supported by Mooncake and NIXL UCX. Mapping keys are process-visible GPU IDs (after CUDA_VISIBLE_DEVICES); use HCA names without port suffixes for NIXL UCX. For NIXL UCX, a non-empty UCX_NET_DEVICES takes precedence over this option, including per-GPU mappings. Default is None, which preserves backend device selection.'] = None, disaggregation_decode_enable_radix_cache: Annotated[bool, 'Enable radix cache on decode server (PD mode). Caches KV prefixes to avoid redundant transfers. Incompatible with --enable-hisparse, --disaggregation-transfer-backend fake, and speculative algorithms other than EAGLE, EAGLE3, and DSPARK.'] = False, disaggregation_decode_enable_offload_kvcache: Annotated[bool, 'Enable async KV cache offloading on decode server (PD mode).'] = False, disaggregation_decode_retraction_backup: Annotated[Optional[str], Arg(help="Storage backend for KV preserved across PD decode retraction. 'cpu_tensor' uses per-request CPU tensors. 'host_pool' uses a reserved HiCache pool and does not fall back on exhaustion. 'none' keeps no backup: a retracted request is aborted with 503 for the client to retry. If omitted, the backend is inferred from the decode KV pool.", choices=['cpu_tensor', 'host_pool', 'none'], aliases=None, cli_name=None, type_parser=None, nargs=None, required=None, action=None, action_kwargs=None, const=None, no_cli=False, resolvable=False, fallback=None)] = None, num_reserved_decode_tokens: Annotated[int, 'Number of decode tokens that will have memory reserved when adding new request to the running batch.'] = 512, disaggregation_decode_extra_slots: Annotated[Optional[int], 'Number of extra decode req_to_token slots pre-allocated for in-transfer requests (PD mode). If unset, defaults to 0 (or 2x the per-worker running batch for small batches).'] = None, disaggregation_decode_polling_interval: Annotated[int, 'The interval to poll requests in decode server. Can be set to >1 to reduce the overhead of this.'] = 1, optimistic_prefill_attempts: Annotated[int, 'Number of optimistic prefill forward passes that skip the bootstrap wait.'] = 0, encoder_only: Annotated[bool, 'For MLLM with an encoder, launch an encoder-only server'] = False, language_only: Annotated[bool, 'For VLM, load weights for the language model only.'] = False, language_model_only: Annotated[bool, 'Skip the multimodal encoder entirely: its weights are never loaded and the tower is never built, freeing that GPU memory for KV cache. Multimodal requests are rejected. Unlike --language-only this is a standalone mode, not part of encoder/decoder disaggregation.'] = False, encoder_transfer_backend: Annotated[str, Arg(help='The backend for encoder disaggregation transfer. Auto selects a model- and TP-aware backend.', choices=['auto', 'zmq_to_scheduler', 'zmq_to_tokenizer', 'mooncake'], aliases=None, cli_name=None, type_parser=None, nargs=None, required=None, action=None, action_kwargs=None, const=None, no_cli=False, resolvable=False, fallback=None)] = 'auto', encoder_urls: Annotated[List[str], 'List of encoder server urls.'] = <factory>, encoder_bootstrap_port: Annotated[int, 'Port for the EncoderBootstrapServer that runs in the language-only tokenizer manager process. Encoders register here, and language-only receivers fetch the current URL list from here.'] = 8997, encoder_register_urls: Annotated[List[str], 'One or more EncoderBootstrapServer URLs to register this encoder with on startup, for dynamic encoder discovery. Example: --encoder-register-urls http://prefill0:8997 http://prefill1:8997. Used with --encoder-only servers.'] = <factory>, enable_adaptive_dispatch_to_encoder: Annotated[bool, 'When enabled, adaptively dispatch: multi-image requests go to encoder in language_only epd mode, single-image requests are processed locally.'] = False, enable_pdmux: Annotated[bool, 'Enable PD-Multiplexing, PD running on greenctx stream.'] = False, pdmux_config_path: Annotated[Optional[str], 'The path of the PD-Multiplexing config file.'] = None, sm_group_num: Annotated[int, 'Number of sm partition groups.'] = 8, startup_weight_load_mode: Annotated[Literal['serial', 'overlap'], "Control startup weight loading relative to CUDA graph capture. 'serial' preserves the existing startup order; 'overlap' stages checkpoint files while CUDA graphs are captured and commits the real weights