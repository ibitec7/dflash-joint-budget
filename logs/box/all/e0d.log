None, action_kwargs=None, const=None, no_cli=False, resolvable=False, fallback=None)] = None, remote_instance_weight_loader_backend: Annotated[Literal['transfer_engine', 'nccl', 'modelexpress'], "The backend for loading weights from remote instance. Can be 'transfer_engine', 'nccl', or 'modelexpress'. Default is 'nccl'."] = 'nccl', remote_instance_weight_loader_start_seed_via_transfer_engine: Annotated[bool, 'Start seed server via transfer engine backend for remote instance weight loader.'] = False, engine_info_bootstrap_port: Annotated[int, 'Port for the engine info bootstrap server. Default is 6789. Must be set explicitly when running multiple instances on the same node.'] = 6789, modelexpress_config: Annotated[Optional[str], 'JSON config for ModelExpress P2P weight loading. Keys: "url" (optional gRPC host:port override), "transport" ("nixl" or "transfer_engine"). Example: \'{"url": "localhost:8001", "transport": "nixl"}\''] = None, download_dir: Annotated[Optional[str], 'Model download directory for huggingface.'] = None, model_checksum: Annotated[Optional[str], Arg(help='Model file integrity verification. If provided without value, uses model-path as HF repo ID. Otherwise, provide checksums JSON file path or HuggingFace repo ID.', choices=None, aliases=None, cli_name=None, type_parser=None, nargs='?', required=None, action=None, action_kwargs=None, const='', no_cli=False, resolvable=False, fallback=None)] = None, delete_ckpt_after_loading: Annotated[bool, 'Delete the model checkpoint after loading the model.'] = False, decrypted_config_file: Annotated[Optional[str], 'The path of the decrypted config file.'] = None, decrypted_draft_config_file: Annotated[Optional[str], 'The path of the decrypted draft config file.'] = None, checkpoint_engine_wait_weights_before_ready: Annotated[bool, 'If set, the server will wait for initial weights to be loaded via checkpoint-engine or other update methods before serving inference requests.'] = False, enable_prefill_delayer: Annotated[bool, 'Enable prefill delayer for DP attention to reduce idle time.'] = False, prefill_delayer_max_delay_passes: Annotated[int, 'Maximum forward passes to delay prefill.'] = 30, prefill_delayer_token_usage_low_watermark: Annotated[Optional[float], 'Token usage low watermark for prefill delayer.'] = None, prefill_delayer_forward_passes_buckets: Annotated[Optional[List[float]], 'Custom buckets for prefill delayer forward passes histogram. 0 and max_delay_passes-1 will be auto-added.'] = None, prefill_delayer_wait_seconds_buckets: Annotated[Optional[List[float]], 'Custom buckets for prefill delayer wait seconds histogram. 0 will be auto-added.'] = None, prefill_delayer_queue_min_ratio: Annotated[Optional[float], 'Opt-in to the adaptive queue-based delay trigger (independent of the slot-based one). Delays prefill until the waiting queue reaches min(running_req * ratio, prefill_max_requests), falling back to the observed max_prefill_bs when no request limit is set. Unset (default) keeps the original slot-only behavior. Typical: 0.1 ~ 0.5.'] = None, prefill_delayer_max_delay_ms: Annotated[Optional[float], 'Wall-clock cap (ms) on a single queue-trigger delay; once exceeded, prefill is force-released to bound worst-case TTFT. Only consulted when --prefill-delayer-queue-min-ratio is set. Typical: 1000 ~ 5000; defaults to 5000 if unset.'] = None, min_free_slots_delay: Annotated[Optional[int], 'Hold new prefills until at least N running-request slots have freed up, so they are admitted in one batch instead of one at a time. Useful when each admission is disproportionately expensive, e.g. speculative decoding with a separate draft prefill pass. An explicit value always wins, capped by max-running-requests (1 disables). When unset, DFlash workloads auto-enable the formula; other workloads stay disabled. Not supported with pipeline parallelism.'] = None, enable_deterministic_inference: Annotated[bool, 'Enable deterministic inference mode with batch invariant ops.'] = False, rl_on_policy_target: Annotated[Optional[str], Arg(help='The training system that SGLang needs to match for true on-policy.', choices=['fsdp'], aliases=None, cli_name=None, type_parser=None, nargs=None, required=None, action=None, action_kwargs=None, const=None, no_cli=False, resolvable=False, fallback=None)] = None, kv_canary: Annotated[str, Arg(help="KV cache canary mode. 'none' disables the canary (default). 'log' prints them while the server keeps running (production-safe). 'raise' fails the server on the first detected mismatch (CI lane).", choices=['none', 'log', 'raise'], aliases=None, cli_name=None, type_parser=None, nargs=None, required=None, action=None, action_kwargs=None, const=None, no_cli=False, resolvable=False, fallback=None)] = 'none', kv_canary_real_data: str = 'none', kv_canary_sweep_interval: Annotated[int, 'Every N forward steps, run a full-pool sweep.'] = 0, enable_dynamic_batch_tokenizer: Annotated[bool, 'Enable async dynamic batch tokenizer for improved performance when multiple requests arrive concurrently.'] = False, dynamic_batch_tokenizer_batch_size: Annotated[int, '[Only used if --enable-dynamic-batch-tokenizer is set] Maximum batch size for dynamic batch tokenizer.'] = 32, dynamic_batch_tokenizer_batch_timeout: Annotated[float, '[Only used if --enable-dynamic-batch-tokenizer is set] Timeout in seconds for batching tokenization requests.'] = 0.002, enable_tokenizer_batch_encode: Annotated[bool, 'Enable batch tokenization for improved performance when processing multiple text inputs. Do not use with image inputs, pre-tokenized input_ids, or input_embeds.'] = False, disable_tokenizer_batch_decode: Annotated[bool, 'Disable batch decoding when decoding multiple completions.'] = False, debug_tensor_dump_output_folder: Annotated[Optional[str], "The output folder for dumping tensors. In Eagle mode, tensor outputs from draft and target models are stored in separate subdirectories ('draft' and 'target')."] = None, debug_tensor_dump_layers: Annotated[Optional[List[int]], 'The layer ids to dump. Dump all layers if not specified.'] = None, debug_tensor_dump_input_file: Annotated[Optional[str], 'The input filename for dumping tensors'] = None, enable_memory_saver: Annotated[bool, 'Allow saving memory using release_memory_occupation and resume_memory_occupation'] = False, enable_weights_cpu_backup: Annotated[bool, 'Save model weights (both main model and draft model, if any) to CPU memory during release_weights_occupation and resume_weights_occupation'] = False, enable_draft_weights_cpu_backup: Annotated[bool, 'Save draft model weights to CPU memory during release_weights_occupation and resume_weights_occupation'] = False, enable_custom_logit_processor: Annotated[bool, 'Enable users to pass custom logit processors to the server (disabled by default for security)'] = False, enable_return_hidden_states: Annotated[bool, 'Enable returning full hidden states with responses. Equivalent to `--return-hidden-states-mode full`.'] = False, return_hidden_states_mode: Annotated[Optional[str], Arg(help='Set the maximum hidden-state return mode supported by the server. `last` allows requests with return_hidden_states=False or `last`; `full` also allows return_hidden_states=True.', choices=['last', 'full'], aliases=None, cli_name=None, type_parser=None, nargs=None, required=None, action=None, action_kwargs=None, const=None, no_cli=False, resolvable=False, fallback=None)] = None, enable_return_routed_experts: Annotated[bool, 'Enable returning routed experts of each layer with responses.'] = False, enable_return_indexer_topk: Annotated[bool, 'Enable returning indexer topk indices of layers with indexer with responses.'] = False, sampling_mask_max_tokens: Annotated[int, 'The maximum number of token IDs in a returned sampling mask. Requests are aborted if their realized sampling support exceeds this limit. Use the same value on disaggregated prefill and decode nodes; clients should set top_k below the limit to leave headroom for cutoff ties.'] = 4096, disable_outlines_disk_cache: Annotated[bool, 'Disable disk cache of outlines to avoid possible crashes related to file system or high concurrency.'] = False, enable_mis: Annotated[bool, 'Enable Multi-Item Scoring optimization. Combines query and multiple items into a single sequence for efficient batch processing. Requires --attention-backend flashinfer; auto-disables CUDA graph, radix cache, and chunked prefill.'] = False, weight_cache_mode: Annotated[str, Arg(help="Weight cache mode. 'off': normal disk loading. 'daemon': launch weight cache daemon (holds weights in GPU memory). Engine-spawned daemons are co-terminal with the engine and do NOT persist across restarts, so this alone does not speed up restart (the first start is slower). For fast recovery, run the standalone daemon (python -m sglang.srt.weight_cache.daemon) and connect with 'client'. 'client': connect to existing daemon and load via IPC.", choices=['off', 'daemon', 'client'], aliases=None, cli_name=None, type_parser=None, nargs=None, required=None, action=None, action_kwargs=None, const=None, no_cli=False, resolvable=False, fallback=None)] = 'off', weight_cache_socket: Annotated[Optional[str], Arg(help="Unix socket path for weight cache daemon (client mode).If not set, derives the path from SGLANG_WEIGHT_CACHE_SOCKET_TEMPLATE using the caller's physical GPU UUID.", choices=None, aliases=None, cli_name=None, type_parser=None, nargs=None, required=None, action=None, action_kwargs=None, const=None, no_cli=False, resolvable=False, fallback=None)] = None, weight_cache_timeout: Annotated[int, Arg(help='Timeout in seconds for weight cache daemon readiness (default: 1800).', choices=None, aliases=None, cli_name=None, type_parser=None, nargs=None, required=None, action=None, action_kwargs=None, const=None, no_cli=False, resolvable=False, fallback=None)] = 1800, forward_hooks: Annotated[Optional[List[dict[str, Any]]], Arg(help='JSON-formatted forward hook specifications to attach to the model.', choices=None, aliases=None, cli_name=None, type_parser=<function json_list_type at 0x7fbdc074d8a0>, nargs=None, required=None, action=None, action_kwargs=None, const=None, no_cli=False, resolvable=False, fallback=None)] = None, msprobe_dump_config: Annotated[Optional[str], 'The path of the JSON configuration file for msProbe. If specified, enables msProbe dump.'] = None, ple_offload_embedding: Annotated[Optional[bool], Arg(help='Offload Qwen4 PLE n-gram embedding weights to CPU pinned memory. Enabled by default for BF16 Qwen4-Exp on CUDA; use --no-ple-offload-embedding to disable.', choices=None, aliases=None, cli_name=None, type_parser=None, nargs=None, required=None, action=<class 'argparse.BooleanOptionalAction'>, action_kwargs=None, const=None, no_cli=False, resolvable=True, fallback=None)] = None, ple_offload_backend: Annotated[str, Arg(help="Host storage for the offloaded Qwen4 PLE n-gram table. 'pinned' (default) uses CPU pinned memory. 'file' maps a sparse file under --ple-offload-dir and lets the gather kernel read it directly; use it on unified-memory devices (e.g. GB10 / DGX Spark) where pinned host memory comes out of the same pool as the model weights. Requires a device that reports cudaDevAttrPageableMemoryAccessUsesHostPageTables.", choices=['pinned', 'file'], aliases=None, cli_name=None, type_parser=None, nargs=None, required=None, action=None, action_kwargs=None, const=None, no_cli=False, resolvable=False, fallback=None)] = 'pinned', ple_offload_dir: Annotated[Optional[str], Arg(help="Directory for the file-backed PLE table when --ple-offload-backend is 'file'. Defaults to $SGLANG_CACHE_DIR/ple/<model path>, one directory per checkpoint. The file is sparse and reused across restarts; put it on fast local storage (NVMe).", choices=None, aliases=None, cli_name=None, type_parser=None, nargs=None, required=None, action=None, action_kwargs=None, const=None, no_cli=False, resolvable=False, fallback=None)] = None, disaggregation_enable_kv_checksum: Annotated[bool, "Compute an Adler-32 checksum over each request's KV pages on prefill and verify it on decode. Enable on both prefill and decode engines. A mismatch aborts the request, or raises in CI. With a decode-side radix cache the digest covers only the pages prefill sends. A prefill whose KV layout differs (TP width, PP stage, page size, dtype) is admitted unverified with one warning. Disabled by default."] = False, enable_pd_role_switch: Annotated[bool, 'Allow runtime prefill<->decode role switch via /pd_role_switch (PD mode).'] = False, speculative_domino_candidate_pool_size: Annotated[int, 'Domino only. Size of the approximate block-shared base-logit candidate pool. Set to 0 to score the full vocabulary.'] = 2048, flashinfer_a2a_dispatch_type: Annotated[Optional[Literal['auto', 'bf16', 'nvfp4', 'mxfp8']], 'Select FlashInfer A2A dispatcher activation dtype.'] = None, cuda_graph_max_seq_len_prefill: Annotated[Optional[int], 'Longest sequence a prefill cuda graph replay admits; longer batches run eager prefill. Folds into cuda_graph_config[prefill].max_seq_len.'] = None, prefill_kv_cache_dequant_dtype: Annotated[str, Arg(help="Online dequantization dtype used by prefill attention when --kv-cache-dtype=nvfp4. 'nvfp4' reads the packed cache directly without additional dequantization; 'fp8_e4m3' dequantizes it into a temporary FP8 workspace. This does not change the stored KV-cache dtype. 'auto' selects NVFP4 without additional dequantization on SM100 and FP8 E4M3 otherwise.", choices=['auto', 'nvfp4', 'fp8_e4m3'], aliases=None, cli_name=None, type_parser=None, nargs=None, required=None, action=None, action_kwargs=None, const=None, no_cli=False, resolvable=True, fallback=None)] = 'auto', dsv4_attn_backend: Annotated[str, Arg(help="DeepSeek V4 attention backend. 'auto' (default) resolves to 'flashmla' where 'flashmla_mega' is unsupported or, outside PD disaggregation, where attention is tensor-parallel across ranks (attention TP > 1), and to 'flashmla_mega' otherwise. 'trtllm' (opt-in, SM100/SM103 with FP8 KV cache) switches the SWA/compressed KV pools to a uniform 512-dim FP8 layout and runs decode and sparse prefill through the flashinfer trtllm-gen sparse MLA kernel. 'flashmla_mega' (DeepSeek-V4.1 on SM100/SM103) runs the fused Q-RoPE + sparse attention + inverse-RoPE + MXFP8 FlashMLA kernel. The backend choice is shared by prefill and decode.", choices=['auto', 'flashmla', 'flashmla_mega', 'trtllm'], aliases=None, cli_name=None, type_parser=None, nargs=None, required=None, action=None, action_kwargs=None, const=None, no_cli=False, resolvable=True, fallback=None)] = 'auto', otlp_service_name: Annotated[Optional[str], "Service name for OTLP traces (displayed as 'service.name' in trace backends). If unset, falls back to the OTEL_SERVICE_NAME env var, then to 'sglang'."] = None, _radix_eviction_policy_explicitly_set: Annotated[bool, Arg(help='', choices=None, aliases=None, cli_name=None, type_parser=None, nargs=None, required=None, action=None, action_kwargs=None, const=None, no_cli=True, resolvable=False, fallback=None)] = False, hicache_host_memory_fraction: Annotated[Optional[float], 'Fraction of the available host memory, bounded by visible cgroup memory.max/memory.high or v1 memory limits (after a 10 GiB reserve) that the HiCache host pools of all ranks on this machine may use. Applies only when neither --hicache-ratio nor --hicache-size is set: the default ratio is then reduced until the pools fit. Lower it when several engines share a memory cgroup.'] = 0.8, enable_linker_mla_dedup: Annotated[bool, 'Load replicated MLA KV on rank 0 and broadcast each layer with the Mooncake linker.'] = False, _swa_full_tokens_ratio_explicitly_set: Annotated[Optional[bool], Arg(help='', choices=None, aliases=None, cli_name=None, type_parser=None, nargs=None, required=None, action=None, action_kwargs=None, const=None, no_cli=True, resolvable=False, fallback=None)] = None, swa_prefix_tails: Annotated[Optional[int], Arg(help='When the S